# ═══════════════════════════════════════
# DevFlow Environment Variables
# Copy this file to .env and fill in values
# ═══════════════════════════════════════

# ─── Jira (Required) ──────────────────
DEVFLOW_JIRA_TOKEN=your-jira-api-token

# ─── Figma (Optional) ─────────────────
DEVFLOW_FIGMA_TOKEN=your-figma-personal-access-token

# ─── Git Platform (Pick one) ──────────
DEVFLOW_GITHUB_TOKEN=your-github-pat
# DEVFLOW_GITLAB_TOKEN=your-gitlab-pat
# DEVFLOW_BITBUCKET_TOKEN=your-bitbucket-app-password

# ─── Deploy Notifications (Optional) ──
# DEVFLOW_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# DEVFLOW_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# ─── Redis (for caching) ──────────────
REDIS_URL=redis://redis:6379

# ─── App ───────────────────────────────
NODE_ENV=development
PORT=3456
